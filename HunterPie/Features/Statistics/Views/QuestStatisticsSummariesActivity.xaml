<architecture:Activity x:Class="HunterPie.Features.Statistics.Views.QuestStatisticsSummariesActivity"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:architecture="clr-namespace:HunterPie.UI.Architecture;assembly=HunterPie.UI"
                       xmlns:buttons="clr-namespace:HunterPie.UI.Controls.Buttons;assembly=HunterPie.UI"
                       xmlns:converters="clr-namespace:HunterPie.UI.Architecture.Converters;assembly=HunterPie.UI"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:feedback="clr-namespace:HunterPie.UI.Controls.Feedback;assembly=HunterPie.UI"
                       xmlns:markup="clr-namespace:HunterPie.UI.Architecture.Markup;assembly=HunterPie.UI"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:paginating="clr-namespace:HunterPie.UI.Controls.Paginating;assembly=HunterPie.UI"
                       xmlns:viewModels="clr-namespace:HunterPie.Features.Statistics.ViewModels"
                       xmlns:viewer="clr-namespace:HunterPie.UI.Controls.Viewer;assembly=HunterPie.UI"
                       xmlns:views="clr-namespace:HunterPie.Features.Statistics.Views"
                       Margin="5"
                       d:DataContext="{d:DesignInstance viewModels:QuestStatisticsSummariesViewModel}"
                       d:DesignHeight="450"
                       d:DesignWidth="800"
                       x:ClassModifier="internal"
                       Loaded="OnLoaded"
                       mc:Ignorable="d">
	<architecture:Activity.Resources>
		<converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
		<DataTemplate x:Key="PromptSupporterTier1">
			<buttons:Button Margin="5"
			                Padding="0"
			                HorizontalAlignment="Center"
			                VerticalAlignment="Center"
			                HorizontalContentAlignment="Stretch"
			                VerticalContentAlignment="Stretch"
			                Click="OnSupporterPromptClick">
				<feedback:Prompt BorderBrush="{DynamicResource Blue@200}"
				                 BorderThickness="1"
				                 HorizontalAlignment="Center"
				                 d:Text="Become a Supporter to see more than 7 days of hunts!"
				                 Background="{DynamicResource Blue@700}"
				                 CornerRadius="5"
				                 Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
				                 Icon="{DynamicResource ICON_SUPPORTER_TIER_1}"
				                 Text="{markup:Localization '//Strings/Client/Main/String[@Id=&quot;CLIENT_HUNT_EXPORT_SUPPORTER_FREE_TIER_STRING&quot;]'}" />
			</buttons:Button>
		</DataTemplate>

		<DataTemplate x:Key="PromptSupporterTier2">
			<buttons:Button Margin="5"
			                Padding="0"
			                HorizontalAlignment="Center"
			                VerticalAlignment="Center"
			                HorizontalContentAlignment="Stretch"
			                VerticalContentAlignment="Stretch"
			                Click="OnSupporterPromptClick">
				<feedback:Prompt BorderBrush="{DynamicResource Violet@50}"
				                 BorderThickness="1"
				                 HorizontalAlignment="Center"
				                 d:Text="Become a Tier 2 Supporter to see more than 30 days of hunts!"
				                 Background="{DynamicResource Violet@700}"
				                 CornerRadius="5"
				                 Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
				                 Icon="{DynamicResource ICON_SUPPORTER_TIER_2}"
				                 Text="{markup:Localization '//Strings/Client/Main/String[@Id=&quot;CLIENT_HUNT_EXPORT_SUPPORTER_LOW_TIER_STRING&quot;]'}" />
			</buttons:Button>
		</DataTemplate>

		<DataTemplate x:Key="QuestSummaryTemplate">
			<views:QuestStatisticsSummaryView Height="130"
			                                  Click="OnSummaryClick" />
		</DataTemplate>

	</architecture:Activity.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="1*" />
		</Grid.RowDefinitions>
		<Border Grid.Row="0"
		        BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
		        BorderThickness="1"
		        Background="{DynamicResource Brushes.HunterPie.Background.Secondary}"
		        CornerRadius="5,5,0,0">
			<Grid Margin="5,3">
				<ComboBox Width="150"
				          Height="35"
				          HorizontalAlignment="Left"
				          VerticalAlignment="Center"
				          ItemStringFormat="Display {0}"
				          ItemsSource="{Binding PageLimitSizes, Mode=OneTime}"
				          SelectedItem="{Binding LimitSize, Mode=TwoWay}"
				          SelectionChanged="OnLimitSelectionChange" />

				<TextBlock Grid.Row="0"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           d:Text="Hunts"
				           FontSize="15"
				           FontWeight="Medium"
				           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Tertiary}"
				           Text="{markup:Localization '//Strings/Client/Main/String[@Id=&quot;CLIENT_HUNT_EXPORT_SUMMARY_TITLE_STRING&quot;]'}" />

				<paginating:Pagination Grid.Row="0"
				                       HorizontalAlignment="Right"
				                       CurrentPage="{Binding CurrentPage, Mode=OneWay}"
				                       PageClick="OnPageClick"
				                       TotalPages="{Binding LastPage, Mode=OneWay}" />
			</Grid>
		</Border>

		<Border Grid.Row="1"
		        BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
		        BorderThickness="1,0,1,1"
		        Background="{DynamicResource Brushes.HunterPie.Background.Tertiary}">
			<viewer:SmoothScrollViewer>
				<StackPanel Orientation="Vertical">

					<!--  Supporter prompts  -->
					<ContentControl>
						<ContentControl.Style>
							<Style TargetType="{x:Type ContentControl}">
								<Style.Triggers>
									<DataTrigger Binding="{Binding MessageType, Mode=OneWay}"
									             Value="{x:Static viewModels:QuestSupporterTierMessageType.LowTierMessage}">
										<Setter Property="ContentTemplate" Value="{StaticResource PromptSupporterTier1}" />
									</DataTrigger>
									<DataTrigger Binding="{Binding MessageType, Mode=OneWay}"
									             Value="{x:Static viewModels:QuestSupporterTierMessageType.HighTierMessage}">
										<Setter Property="ContentTemplate" Value="{StaticResource PromptSupporterTier2}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ContentControl.Style>
					</ContentControl>

					<!--  Summaries  -->
					<ContentControl>
						<ContentControl.Style>
							<Style TargetType="{x:Type ContentControl}">
								<Style.Triggers>
									<!--  Is fetching quests  -->
									<DataTrigger Binding="{Binding IsFetchingQuests, Mode=OneWay}"
									             Value="True">
										<Setter Property="Content">
											<Setter.Value>
												<StackPanel Margin="5">
													<views:QuestStatisticsSummarySkeletonView Height="130"
													                                          Margin="2" />
													<views:QuestStatisticsSummarySkeletonView Height="130"
													                                          Margin="2" />
													<views:QuestStatisticsSummarySkeletonView Height="130"
													                                          Margin="2" />
													<views:QuestStatisticsSummarySkeletonView Height="130"
													                                          Margin="2" />
													<views:QuestStatisticsSummarySkeletonView Height="130"
													                                          Margin="2" />
												</StackPanel>
											</Setter.Value>
										</Setter>
									</DataTrigger>

									<!--  Found no quests  -->
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding HasQuests, Mode=OneWay}" Value="False" />
											<Condition Binding="{Binding IsFetchingQuests, Mode=OneWay}" Value="False" />
										</MultiDataTrigger.Conditions>
										<Setter Property="Content">
											<Setter.Value>
												<feedback:Prompt BorderBrush="{DynamicResource Blue}"
												                 BorderThickness="1"
												                 Margin="10"
												                 HorizontalAlignment="Center"
												                 d:Text="There were no exported hunts available in the period available for your account."
												                 Background="{DynamicResource Blue@700}"
												                 CornerRadius="5"
												                 Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}"
												                 Icon="{StaticResource ICON_INFO}"
												                 Text="{markup:Localization '//Strings/Client/Main/String[@Id=&quot;CLIENT_HUNT_EXPORT_NO_LOGS_STRING&quot;]'}" />
											</Setter.Value>
										</Setter>
									</MultiDataTrigger>

									<!--  Found quests  -->
									<MultiDataTrigger>
										<MultiDataTrigger.Conditions>
											<Condition Binding="{Binding HasQuests, Mode=OneWay}" Value="True" />
											<Condition Binding="{Binding IsFetchingQuests, Mode=OneWay}" Value="False" />
										</MultiDataTrigger.Conditions>
										<Setter Property="Content">
											<Setter.Value>
												<ItemsControl IsEnabled="{Binding IsFetchingDetails, Mode=OneWay, Converter={StaticResource InvertBooleanConverter}}"
												              ItemTemplate="{StaticResource QuestSummaryTemplate}"
												              ItemsSource="{Binding Summaries, Mode=OneTime}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Margin="5"
															            Orientation="Vertical" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
												</ItemsControl>
											</Setter.Value>
										</Setter>
									</MultiDataTrigger>

									<!--  Failed to fetch quests  -->
									<DataTrigger Binding="{Binding HasFetchingFailed, Mode=OneWay}"
									             Value="True">
										<Setter Property="Content">
											<Setter.Value>
												<feedback:Prompt BorderBrush="{DynamicResource Red}"
												                 BorderThickness="1"
												                 Margin="10"
												                 HorizontalAlignment="Center"
												                 d:Text="Failed to fetch exported hunts. Try again later."
												                 Background="{DynamicResource Red@700}"
												                 CornerRadius="5"
												                 Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
												                 Icon="{DynamicResource ICON_ERROR_MASK}"
												                 Text="{markup:Localization '//Strings/Client/Main/String[@Id=&quot;CLIENT_HUNT_EXPORT_FETCH_FAILED_ERROR_STRING&quot;]'}" />
											</Setter.Value>
										</Setter>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ContentControl.Style>
					</ContentControl>
				</StackPanel>
			</viewer:SmoothScrollViewer>
		</Border>

	</Grid>
</architecture:Activity>
