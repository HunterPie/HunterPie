<architecture:Activity x:Class="HunterPie.Features.Account.Views.AccountPreferencesActivity"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:architecture="clr-namespace:HunterPie.UI.Architecture;assembly=HunterPie.UI"
                       xmlns:components="clr-namespace:HunterPie.Features.Account.Views.Components"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:HunterPie.Features.Account.Views"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:viewModels="clr-namespace:HunterPie.Features.Account.ViewModels"
                       xmlns:viewer="clr-namespace:HunterPie.UI.Controls.Viewer;assembly=HunterPie.UI"
                       xmlns:views="clr-namespace:HunterPie.Features.Backup.Views"
                       d:DataContext="{d:DesignInstance viewModels:AccountPreferencesViewModel}"
                       d:DesignHeight="400"
                       d:DesignWidth="800"
                       Background="{DynamicResource Brushes.HunterPie.Background.Tertiary}"
                       mc:Ignorable="d">
	<viewer:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel>
			<ContentPresenter Margin="20,10,20,10">
				<ContentPresenter.Style>
					<Style TargetType="ContentPresenter">
						<Style.Triggers>
							<DataTrigger Binding="{Binding DataContext.IsFetchingAccount, RelativeSource={RelativeSource AncestorType={x:Type local:AccountPreferencesActivity}}}"
							             Value="False">
								<DataTrigger.Setters>
									<Setter Property="Content">
										<Setter.Value>
											<!--  Loaded account details  -->
											<components:AccountDetailsView />
										</Setter.Value>
									</Setter>
								</DataTrigger.Setters>
							</DataTrigger>
							<DataTrigger Binding="{Binding DataContext.IsFetchingAccount, RelativeSource={RelativeSource AncestorType={x:Type local:AccountPreferencesActivity}}}"
							             Value="True">
								<DataTrigger.Setters>
									<Setter Property="Content">
										<Setter.Value>
											<local:AccountPreferencesSkeletonView />
										</Setter.Value>
									</Setter>
								</DataTrigger.Setters>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ContentPresenter.Style>
			</ContentPresenter>

			<!--  Backups  -->
			<views:BackupsView Margin="20,0,20,20" />
		</StackPanel>
	</viewer:SmoothScrollViewer>
</architecture:Activity>
