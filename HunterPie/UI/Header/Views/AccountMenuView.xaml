<UserControl x:Class="HunterPie.UI.Header.Views.AccountMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:HunterPie.UI.Controls.Buttons;assembly=HunterPie.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:image="clr-namespace:HunterPie.UI.Controls.Image;assembly=HunterPie.UI"
             xmlns:loading="clr-namespace:HunterPie.UI.Controls.Loading;assembly=HunterPie.UI"
             xmlns:local="clr-namespace:HunterPie.UI.Header.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:HunterPie.UI.Header.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:AccountMenuViewModel}"
             d:DesignHeight="30"
             Loaded="OnLoaded"
             MouseUp="OnMouseButtonUp"
             mc:Ignorable="d">
	<UserControl.Resources>
		<Style x:Key="LoggedInButton"
		       TargetType="buttons:Button">
			<EventSetter Event="Click"
			             Handler="OnClick" />
		</Style>

		<Style x:Key="SignInButton"
		       TargetType="buttons:Button">
			<EventSetter Event="Click"
			             Handler="OnSignInButtonClick" />
		</Style>

		<Style x:Key="PopupButton"
		       TargetType="buttons:Button">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource Brushes.HunterPie.Foreground.Primary}" />
		</Style>
	</UserControl.Resources>
	<Grid>
		<ContentPresenter>
			<ContentPresenter.Style>
				<Style TargetType="ContentPresenter">
					<Setter Property="Content">
						<Setter.Value>
							<buttons:Button BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
							                BorderThickness="1,0,1,1"
							                Padding="5,0,10,0"
							                HorizontalContentAlignment="Stretch"
							                VerticalContentAlignment="Stretch"
							                CornerRadius="0,0,5,5"
							                Cursor="Hand"
							                Style="{StaticResource SignInButton}">
								<StackPanel Orientation="Horizontal">
									<image:Icon Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
									            Margin="0,0,5,0"
									            Padding="0,3"
									            Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}"
									            Image="{DynamicResource ICON_ACCOUNT}" />
									<TextBlock VerticalAlignment="Center"
									           FontSize="12"
									           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
									           Text="Sign In" />
								</StackPanel>
							</buttons:Button>
						</Setter.Value>
					</Setter>
					<Style.Triggers>
						<DataTrigger Binding="{Binding DataContext.IsLoggedIn, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AccountMenuView}}}"
						             Value="True">
							<Setter Property="Content">
								<Setter.Value>
									<buttons:Button BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
									                BorderThickness="1"
									                Padding="0"
									                HorizontalContentAlignment="Stretch"
									                VerticalContentAlignment="Stretch"
									                Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
									                CornerRadius="0,0,5,5"
									                Cursor="Hand"
									                Style="{StaticResource LoggedInButton}">
										<StackPanel Orientation="Horizontal">
											<Border Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
											        CornerRadius="0,0,0,2">
												<Border.Background>
													<ImageBrush ImageSource="{Binding AvatarUrl, Mode=OneWay}"
													            RenderOptions.BitmapScalingMode="Fant"
													            Stretch="UniformToFill" />
												</Border.Background>
											</Border>
											<TextBlock Margin="5,0,0,0"
											           VerticalAlignment="Center"
											           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
											           Text="{Binding Username, Mode=OneWay}" />
											<Path Margin="5"
											      HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"
											      Fill="{DynamicResource Brushes.HunterPie.Accent}" />
										</StackPanel>
									</buttons:Button>
								</Setter.Value>
							</Setter>
						</DataTrigger>

						<DataTrigger Binding="{Binding DataContext.IsLoading, Mode=OneWay, RelativeSource={RelativeSource AncestorType={x:Type local:AccountMenuView}}}"
						             Value="True">
							<Setter Property="Content">
								<Setter.Value>
									<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
									        BorderThickness="1"
									        Padding="2"
									        Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
									        CornerRadius="0,0,5,5">
										<StackPanel Orientation="Horizontal">
											<loading:Skeleton Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
											                  Background="{DynamicResource Brushes.HunterPie.Border}" />
											<loading:Skeleton Width="80"
											                  Padding="2,5,0,5"
											                  VerticalAlignment="Stretch"
											                  Background="{DynamicResource Brushes.HunterPie.Background.Primary}" />
										</StackPanel>
									</Border>
								</Setter.Value>
							</Setter>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ContentPresenter.Style>
		</ContentPresenter>

		<Popup x:Name="PART_Popup"
		       AllowsTransparency="True"
		       IsOpen="{Binding IsOpen, Mode=OneWay, NotifyOnTargetUpdated=True}"
		       PopupAnimation="Fade"
		       TargetUpdated="OnDropDownChanged">
			<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
			        BorderThickness="1"
			        Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
			        CornerRadius="0,0,5,5">
				<StackPanel Orientation="Vertical">
					<buttons:Button Click="OnAccountDetailsClick"
					                Content="View my account"
					                Style="{StaticResource PopupButton}" />
					<buttons:Button Click="OnAccountSettingsClick"
					                Content="Account settings"
					                Style="{StaticResource PopupButton}" />
					<buttons:Button Click="OnSignOutClick"
					                Content="Sign out"
					                Style="{StaticResource PopupButton}" />
				</StackPanel>
			</Border>
		</Popup>
	</Grid>
</UserControl>
