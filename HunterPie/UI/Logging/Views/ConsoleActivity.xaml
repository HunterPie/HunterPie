<architecture:Activity x:Class="HunterPie.UI.Logging.Views.ConsoleActivity"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:architecture="clr-namespace:HunterPie.UI.Architecture;assembly=HunterPie.UI"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:local="clr-namespace:HunterPie.UI.Logging.Views"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:viewModels="clr-namespace:HunterPie.UI.Logging.ViewModels"
                       xmlns:viewer="clr-namespace:HunterPie.UI.Controls.Viewer;assembly=HunterPie.UI"
                       d:DataContext="{d:DesignInstance viewModels:ConsoleViewModel}"
                       d:DesignHeight="450"
                       d:DesignWidth="800"
                       mc:Ignorable="d">
	<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
	        BorderThickness="1"
	        Margin="5,5,5,8"
	        Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
	        CornerRadius="5">
		<ListBox BorderThickness="0"
		         Background="Transparent"
		         ItemsSource="{Binding Logs, Mode=OneTime}"
		         VirtualizingPanel.ScrollUnit="Pixel"
		         VirtualizingPanel.VirtualizationMode="Standard">
			<ListBox.Template>
				<ControlTemplate>
					<viewer:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled">
						<ItemsPresenter Margin="5" />
					</viewer:SmoothScrollViewer>
				</ControlTemplate>
			</ListBox.Template>

			<ListBox.ItemTemplate>
				<DataTemplate>
					<local:LogView Margin="0,0,0,2" />
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
	</Border>
</architecture:Activity>
