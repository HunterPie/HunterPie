<UserControl x:Class="HunterPie.UI.SideBar.Views.FixedSideBarButtonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:HunterPie.UI.Controls.Buttons;assembly=HunterPie.UI"
             xmlns:converters="clr-namespace:HunterPie.UI.Architecture.Converters;assembly=HunterPie.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:handler="clr-namespace:HunterPie.UI.Client.Sidebar.Handler;assembly=HunterPie.UI"
             xmlns:image="clr-namespace:HunterPie.UI.Controls.Image;assembly=HunterPie.UI"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:presentation="clr-namespace:HunterPie.UI.SideBar.Presentation"
             xmlns:resolvers="clr-namespace:HunterPie.UI.Architecture.Resolvers;assembly=HunterPie.UI"
             d:DataContext="{d:DesignInstance handler:NavigationHandler}"
             d:DesignHeight="50"
             d:DesignWidth="50"
             MouseEnter="OnMouseEnter"
             MouseLeave="OnMouseLeave"
             mc:Ignorable="d">
	<UserControl.Resources>
		<converters:IconResolver x:Key="IconResolver" />
		<converters:LocalizationResolver x:Key="LocalizationResolver" />
		<presentation:SideBarButtonStateToBooleanConverter x:Key="SideBarButtonStateToBooleanConverter" />
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<resolvers:BooleanResolver x:Key="ActiveColorResolver"
		                           Falsy="{StaticResource Brushes.HunterPie.Foreground.Secondary}"
		                           Truthy="{StaticResource Blue@100}" />
	</UserControl.Resources>
	<Grid>
		<Popup x:Name="PART_Popup"
		       AllowsTransparency="True"
		       Placement="Right"
		       PlacementTarget="{Binding ElementName=PART_Button}">
			<Grid Height="{Binding ActualHeight, ElementName=PART_Button}">
				<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
				        BorderThickness="1"
				        Margin="2"
				        Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
				        CornerRadius="5"
				        RenderTransformOrigin="0.5,0.5">
					<Border.RenderTransform>
						<ScaleTransform ScaleX="1" ScaleY="1" />
					</Border.RenderTransform>
					<TextBlock Margin="5"
					           VerticalAlignment="Center"
					           FontSize="14"
					           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}"
					           Text="{Binding Label, Mode=OneWay}" />

					<Border.Style>
						<Style TargetType="Border">
							<Style.Triggers>
								<Trigger Property="IsVisible" Value="True">
									<Trigger.EnterActions>
										<BeginStoryboard>
											<Storyboard>
												<DoubleAnimation Storyboard.TargetProperty="Opacity"
												                 From="0"
												                 To="1"
												                 Duration="0:0:0.25">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
												                 From="0.8"
												                 To="1"
												                 Duration="0:0:0.2">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
												<DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
												                 From="0.8"
												                 To="1"
												                 Duration="0:0:0.2">
													<DoubleAnimation.EasingFunction>
														<QuadraticEase />
													</DoubleAnimation.EasingFunction>
												</DoubleAnimation>
											</Storyboard>
										</BeginStoryboard>
									</Trigger.EnterActions>
								</Trigger>
							</Style.Triggers>
						</Style>
					</Border.Style>
				</Border>


			</Grid>
		</Popup>
		<buttons:Button x:Name="PART_Button"
		                Padding="0"
		                HorizontalContentAlignment="Stretch"
		                VerticalContentAlignment="Stretch"
		                Click="OnClick"
		                CornerRadius="20"
		                IsEnabled="{Binding State, Mode=OneWay, Converter={StaticResource SideBarButtonStateToBooleanConverter}}">
			<buttons:Button.Style>
				<Style TargetType="buttons:Button">
					<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Background.Primary}" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsActive, Mode=OneWay}"
						             Value="True">
							<Setter Property="Background" Value="{DynamicResource Blue@700}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</buttons:Button.Style>
			<Grid>
				<image:Icon Margin="10"
				            d:Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
				            d:Image="{DynamicResource ICON_HUNTERPIE}"
				            Foreground="{Binding IsActive, Mode=OneWay, Converter={StaticResource ActiveColorResolver}}"
				            Image="{Binding Icon, Mode=OneWay}" />
			</Grid>
		</buttons:Button>
	</Grid>
</UserControl>
