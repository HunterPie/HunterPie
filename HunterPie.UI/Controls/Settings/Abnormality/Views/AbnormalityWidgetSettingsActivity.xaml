<architecture:Activity x:Class="HunterPie.UI.Controls.Settings.Abnormality.Views.AbnormalityWidgetSettingsActivity"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:architecture="clr-namespace:HunterPie.UI.Architecture"
                       xmlns:assets="clr-namespace:HunterPie.UI.Architecture.Assets"
                       xmlns:buttons="clr-namespace:HunterPie.UI.Controls.Buttons"
                       xmlns:converters="clr-namespace:HunterPie.UI.Architecture.Converters"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:image="clr-namespace:HunterPie.UI.Controls.Image"
                       xmlns:local="clr-namespace:HunterPie.UI.Controls.Settings.Abnormality.Views"
                       xmlns:localPresentation="clr-namespace:HunterPie.UI.Controls.Settings.Abnormality.Presentation"
                       xmlns:markup="clr-namespace:HunterPie.UI.Architecture.Markup"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:models="clr-namespace:HunterPie.UI.Settings.Models"
                       xmlns:presentation="clr-namespace:HunterPie.UI.Settings.Presentation"
                       xmlns:textBox="clr-namespace:HunterPie.UI.Controls.TextBox"
                       xmlns:viewModels="clr-namespace:HunterPie.UI.Controls.Settings.Abnormality.ViewModels"
                       xmlns:viewer="clr-namespace:HunterPie.UI.Controls.Viewer"
                       d:DataContext="{d:DesignInstance viewModels:AbnormalityWidgetSettingsViewModel}"
                       d:DesignHeight="450"
                       d:DesignWidth="800"
                       mc:Ignorable="d">
	<architecture:Activity.Resources>
		<presentation:ConfigurationPropertyDataTemplateSelector x:Key="ConfigurationPropertyDataTemplateSelector" />
		<localPresentation:AbnormalityElementSelectedConverter x:Key="AbnormalityElementSelectedConverter" />
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<converters:IconResolver x:Key="IconResolver" />

		<!--  Abnormality Container Templates  -->
		<DataTemplate x:Key="HeaderTemplate"
		              DataType="{x:Type viewModels:AbnormalityCategoryViewModel}">
			<buttons:TabItem Title="{Binding Name, Mode=OneWay}"
			                 Margin="1"
			                 Description="{Binding Description, Mode=OneWay}"
			                 FontSize="13"
			                 Icon="{Binding Icon, Mode=OneWay, Converter={StaticResource IconResolver}}" />
		</DataTemplate>

		<DataTemplate x:Key="PanelTemplate"
		              DataType="{x:Type viewModels:AbnormalityCategoryViewModel}">

			<ListBox BorderThickness="0"
			         Background="Transparent"
			         ItemsSource="{Binding Elements, Mode=OneTime}"
			         VirtualizingPanel.ScrollUnit="Pixel"
			         VirtualizingPanel.VirtualizationMode="Standard">
				<ListBox.Template>
					<ControlTemplate TargetType="ListBox">
						<viewer:SmoothScrollViewer HorizontalScrollBarVisibility="Disabled"
						                           VerticalScrollBarVisibility="Auto">
							<ItemsPresenter />
						</viewer:SmoothScrollViewer>
					</ControlTemplate>
				</ListBox.Template>
				<ListBox.ItemTemplate>
					<DataTemplate DataType="{x:Type viewModels:AbnormalityElementViewModel}">
						<local:AbnormalityElementView Margin="2"
						                              Click="OnAbnormalityClick"
						                              Visibility="{Binding IsMatch, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
							<local:AbnormalityElementView.IsSelected>
								<MultiBinding Converter="{StaticResource AbnormalityElementSelectedConverter}">
									<Binding Mode="OneTime"
									         Path="Id" />
									<Binding Mode="OneTime"
									         Path="DataContext.SelectedAbnormalities"
									         RelativeSource="{RelativeSource AncestorType={x:Type local:AbnormalityWidgetSettingsActivity}}" />
									<Binding Mode="OneWay"
									         Path="DataContext.SelectedAbnormalities.Count"
									         RelativeSource="{RelativeSource AncestorType={x:Type local:AbnormalityWidgetSettingsActivity}}" />
								</MultiBinding>
							</local:AbnormalityElementView.IsSelected>
						</local:AbnormalityElementView>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</DataTemplate>
	</architecture:Activity.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="80" />
			<RowDefinition Height="1*" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>
			<buttons:Button Grid.Column="0"
			                BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
			                BorderThickness="1"
			                Margin="5"
			                Padding="5"
			                HorizontalAlignment="Left"
			                VerticalAlignment="Top"
			                Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
			                Click="OnBackButtonClick"
			                CornerRadius="5"
			                Cursor="Hand">
				<StackPanel Orientation="Horizontal">
					<image:Icon Width="15"
					            Height="15"
					            Margin="0,0,5,0"
					            Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}"
					            Image="{DynamicResource ICON_CHEVRON_LEFT}" />
					<TextBlock VerticalAlignment="Center"
					           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}"
					           Text="{markup:Localization '//Strings/Client/Generics/Generic[@Id=&quot;BACK_STRING&quot;]'}" />
				</StackPanel>
			</buttons:Button>

			<Grid Grid.Column="1">
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="1*" />
				</Grid.RowDefinitions>

				<textBox:SearchTextBox Grid.Row="0"
				                       Margin="5"
				                       HorizontalAlignment="Stretch"
				                       OnSearchTextChanged="OnSearchTextChange" />

				<StackPanel Grid.Row="1"
				            HorizontalAlignment="Right"
				            Orientation="Horizontal">
					<buttons:Button BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
					                BorderThickness="1"
					                Margin="5"
					                Padding="5"
					                VerticalAlignment="Center"
					                Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
					                Click="OnSelectAllClick"
					                Content="{markup:Localization '//Strings/Client/Generics/Generic[@Id=&quot;SELECT_ALL_STRING&quot;]'}"
					                CornerRadius="5"
					                Cursor="Hand"
					                Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}" />
					<buttons:Button BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
					                BorderThickness="1"
					                Margin="5"
					                Padding="5"
					                VerticalAlignment="Center"
					                Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
					                Click="OnUnselectAllClick"
					                Content="{markup:Localization '//Strings/Client/Generics/Generic[@Id=&quot;UNSELECT_ALL_STRING&quot;]'}"
					                CornerRadius="5"
					                Cursor="Hand"
					                Foreground="{DynamicResource Brushes.HunterPie.Foreground.Secondary}" />
				</StackPanel>
			</Grid>
		</Grid>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="1*" />
			</Grid.ColumnDefinitions>

			<!--  Configuration properties  -->
			<ItemsControl Grid.Column="0"
			              d:ItemsSource="{d:SampleData ItemCount=5}"
			              ItemsSource="{Binding Configuration.Groups, Mode=OneTime}">
				<ItemsControl.Template>
					<ControlTemplate>
						<viewer:SmoothScrollViewer VerticalScrollBarVisibility="Auto">
							<VirtualizingStackPanel CanVerticallyScroll="True"
							                        IsItemsHost="True"
							                        VirtualizationMode="Recycling" />
						</viewer:SmoothScrollViewer>
					</ControlTemplate>
				</ItemsControl.Template>

				<ItemsControl.ItemTemplate>
					<DataTemplate DataType="{x:Type models:ConfigurationGroup}">
						<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
						        BorderThickness="1"
						        Margin="5,5"
						        Padding="5"
						        Background="{DynamicResource Brushes.HunterPie.Background.Secondary}"
						        CornerRadius="5">
							<StackPanel Margin="0,0,0,20"
							            Orientation="Vertical">
								<Grid Margin="0,0,10,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<TextBlock Grid.Column="0"
									           Margin="5"
									           FontSize="15"
									           FontWeight="Medium"
									           Foreground="{DynamicResource Brushes.HunterPie.Foreground.Tertiary}"
									           Text="{Binding Name, Mode=OneTime}" />
									<Separator Grid.Column="1"
									           Background="{DynamicResource Brushes.HunterPie.Border}" />
								</Grid>

								<ItemsControl ItemsSource="{Binding Properties, Mode=OneTime}">
									<ItemsControl.Template>
										<ControlTemplate>
											<VirtualizingStackPanel CanVerticallyScroll="False"
											                        IsItemsHost="True"
											                        SizeChanged="OnSizeChanged" />
										</ControlTemplate>
									</ItemsControl.Template>

									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<ContentPresenter ContentTemplateSelector="{StaticResource ConfigurationPropertyDataTemplateSelector}"
											                  Loaded="OnSettingPropertyLoaded">
												<ContentPresenter.LayoutTransform>
													<ScaleTransform ScaleY="0" />
												</ContentPresenter.LayoutTransform>
											</ContentPresenter>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<!--  Splitter  -->
			<GridSplitter Grid.Column="0"
			              Width="2"
			              Background="Transparent" />

			<!--  Abnormalities  -->
			<TabControl Grid.Column="1"
			            BorderThickness="0"
			            Background="Transparent"
			            ContentTemplate="{StaticResource PanelTemplate}"
			            ItemTemplate="{StaticResource HeaderTemplate}"
			            ItemsSource="{Binding Categories, Mode=OneTime}"
			            SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" />
		</Grid>
	</Grid>
</architecture:Activity>
