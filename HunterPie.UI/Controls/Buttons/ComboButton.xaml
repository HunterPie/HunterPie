<UserControl x:Class="HunterPie.UI.Controls.Buttons.ComboButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HunterPie.UI.Controls.Buttons"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="ComboButtonControl"
             d:DesignHeight="50"
             d:DesignWidth="230"
             Loaded="OnLoaded"
             PreviewMouseDown="OnMouseDown"
             mc:Ignorable="d">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="5*" />
			<ColumnDefinition Width="1*" />
		</Grid.ColumnDefinitions>
		<local:Button Grid.Column="0"
		              BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
		              BorderThickness="1"
		              Padding="0"
		              HorizontalContentAlignment="Stretch"
		              VerticalContentAlignment="Stretch"
		              Background="{DynamicResource Brushes.HunterPie.Background.Primary}"
		              Click="OnClick"
		              Content="{Binding Content, ElementName=ComboButtonControl, Mode=OneWay}"
		              CornerRadius="5,0,0,5" />

		<local:Button x:Name="PART_ExpandButton"
		              Grid.Column="1"
		              BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
		              BorderThickness="0,1,1,1"
		              Background="{DynamicResource Brushes.HunterPie.Background.Secondary}"
		              Click="OnExpandPopupClick"
		              CornerRadius="0,5,5,0">
			<Path HorizontalAlignment="Center"
			      VerticalAlignment="Center"
			      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z"
			      Fill="{DynamicResource Brushes.HunterPie.Accent.Primary}" />
		</local:Button>

		<Popup Grid.Column="0"
		       AllowsTransparency="True"
		       IsOpen="{Binding IsDropDownOpen, ElementName=ComboButtonControl, Mode=OneWay}"
		       PopupAnimation="Fade">
			<Border BorderBrush="{DynamicResource Brushes.HunterPie.Border}"
			        BorderThickness="1"
			        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
			        Background="{DynamicResource Brushes.HunterPie.Background.Tertiary}"
			        CornerRadius="0,0,5,5">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ListBox BorderThickness="0"
					         Background="Transparent"
					         FontFamily="{DynamicResource Font.Default}"
					         ItemTemplate="{Binding ItemTemplate, ElementName=ComboButtonControl, Mode=OneWay}"
					         ItemsSource="{Binding ItemsSource, ElementName=ComboButtonControl, Mode=OneWay}"
					         SelectedItem="{Binding SelectedValue, ElementName=ComboButtonControl, Mode=TwoWay}" />
				</ScrollViewer>
			</Border>
		</Popup>
	</Grid>
</UserControl>
