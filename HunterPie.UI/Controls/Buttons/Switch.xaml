<arch:ClickableControl x:Class="HunterPie.UI.Controls.Buttons.Switch"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:anim="clr-namespace:HunterPie.UI.Architecture.Animation"
                       xmlns:arch="clr-namespace:HunterPie.UI.Architecture"
                       xmlns:converters="clr-namespace:HunterPie.UI.Architecture.Converters"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       Width="45"
                       Height="25"
                       Cursor="Hand"
                       mc:Ignorable="d">
	<arch:ClickableControl.Resources>
		<converters:RelativeSizeConverter x:Key="RelativeSizeConverter" />
		<Style x:Key="StyleForeground"
		       TargetType="{x:Type Rectangle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type arch:ClickableControl}}}"
				             Value="True">
					<Setter Property="Margin" Value="25,0,0,0" />
					<Setter Property="Fill" Value="{DynamicResource Brushes.HunterPie.Foreground.Primary}" />
					<DataTrigger.EnterActions>
						<BeginStoryboard>
							<Storyboard>
								<ThicknessAnimation Storyboard.TargetProperty="Margin"
								                    To="25,0,0,0"
								                    Duration="0:0:0.15">
									<ThicknessAnimation.EasingFunction>
										<QuadraticEase />
									</ThicknessAnimation.EasingFunction>
								</ThicknessAnimation>
								<anim:BrushAnimation Storyboard.TargetProperty="Fill"
								                     To="{StaticResource Brushes.HunterPie.Foreground.Primary}"
								                     Duration="0:0:0.15" />
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.EnterActions>
					<DataTrigger.ExitActions>
						<BeginStoryboard>
							<Storyboard>
								<ThicknessAnimation Storyboard.TargetProperty="Margin"
								                    To="5,0,0,0"
								                    Duration="0:0:0.15">
									<ThicknessAnimation.EasingFunction>
										<QuadraticEase />
									</ThicknessAnimation.EasingFunction>
								</ThicknessAnimation>
								<anim:BrushAnimation Storyboard.TargetProperty="Fill"
								                     To="{StaticResource Brushes.HunterPie.Foreground.Tertiary}"
								                     Duration="0:0:0.15" />
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.ExitActions>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type arch:ClickableControl}}}"
				             Value="False">
					<Setter Property="Margin" Value="5,0,0,0" />
					<Setter Property="Fill" Value="{DynamicResource Brushes.HunterPie.Foreground.Tertiary}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
		<Style x:Key="SwitchBackground"
		       TargetType="{x:Type Rectangle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type arch:ClickableControl}}}"
				             Value="True">
					<Setter Property="Fill" Value="{DynamicResource Brushes.HunterPie.Accent.Primary}" />
					<DataTrigger.EnterActions>
						<BeginStoryboard>
							<Storyboard FillBehavior="Stop">
								<anim:BrushAnimation Storyboard.TargetProperty="Fill"
								                     From="{StaticResource Brushes.HunterPie.Background.Secondary}"
								                     To="{StaticResource Brushes.HunterPie.Accent.Primary}"
								                     Duration="0:0:0.25" />
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.EnterActions>
					<DataTrigger.ExitActions>
						<BeginStoryboard>
							<Storyboard FillBehavior="Stop">
								<anim:BrushAnimation Storyboard.TargetProperty="Fill"
								                     From="{StaticResource Brushes.HunterPie.Accent.Primary}"
								                     To="{StaticResource Brushes.HunterPie.Background.Secondary}"
								                     Duration="0:0:0.25" />
							</Storyboard>
						</BeginStoryboard>
					</DataTrigger.ExitActions>
				</DataTrigger>
				<DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type arch:ClickableControl}}}"
				             Value="False">
					<Setter Property="Fill" Value="{DynamicResource Brushes.HunterPie.Background.Secondary}" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

	</arch:ClickableControl.Resources>
	<Grid>
		<Rectangle Stroke="{DynamicResource Brushes.HunterPie.Border}"
		           StrokeThickness="1"
		           Margin="2"
		           RadiusX="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource RelativeSizeConverter}, ConverterParameter=0.5}"
		           RadiusY="{Binding RadiusX, RelativeSource={RelativeSource Self}}"
		           Style="{StaticResource SwitchBackground}" />

		<Rectangle x:Name="PART_Slider"
		           Width="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}}"
		           Height="{Binding ActualHeight, Converter={StaticResource RelativeSizeConverter}, ConverterParameter=.6, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Grid}}}"
		           HorizontalAlignment="Left"
		           VerticalAlignment="Stretch"
		           RadiusX="20"
		           RadiusY="20"
		           Style="{StaticResource StyleForeground}" />


	</Grid>
</arch:ClickableControl>
