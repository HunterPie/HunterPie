<UserControl x:Class="HunterPie.UI.Controls.Buttons.TabItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HunterPie.UI.Controls.Buttons"
             xmlns:markup="clr-namespace:HunterPie.UI.Architecture.Markup"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="TabItemControl"
             d:DesignHeight="30"
             d:DesignWidth="120"
             ClipToBounds="True"
             Cursor="Hand"
             ToolTip="{Binding Description, ElementName=TabItemControl}"
             ToolTipService.InitialShowDelay="0"
             ToolTipService.Placement="Right"
             mc:Ignorable="d">
	<UserControl.Resources>
		<Storyboard x:Key="RippleAnimation"
		            Storyboard.TargetName="PART_Ripple">
			<DoubleAnimation Storyboard.TargetProperty="Width"
			                 From="0"
			                 Duration="0:0:0.3" />
			<ThicknessAnimation Storyboard.TargetProperty="Margin"
			                    Duration="0:0:0.3" />
			<DoubleAnimation Storyboard.TargetProperty="Opacity"
			                 From="1"
			                 To="0"
			                 Duration="0:0:0.8" />
			<DoubleAnimation BeginTime="0:0:1.25"
			                 Storyboard.TargetProperty="Width"
			                 To="0"
			                 Duration="0:0:0" />
			<DoubleAnimation BeginTime="0:0:1.25"
			                 Storyboard.TargetProperty="Opacity"
			                 To="1"
			                 Duration="0:0:0" />
		</Storyboard>
	</UserControl.Resources>
	<local:Button BorderThickness="1"
	              Padding="0"
	              HorizontalContentAlignment="Stretch"
	              VerticalContentAlignment="Stretch"
	              Click="OnClick"
	              CornerRadius="5">
		<local:Button.Style>
			<Style TargetType="local:Button">
				<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Background.Primary}" />
				<Setter Property="BorderBrush" Value="{DynamicResource Brushes.HunterPie.Border}" />
				<Setter Property="Foreground" Value="{DynamicResource Brushes.HunterPie.Foreground.Secondary}" />
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
					             Value="True">
						<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Accent.Tertiary}" />
						<Setter Property="BorderBrush" Value="{DynamicResource Brushes.HunterPie.Accent.Secondary}" />
						<Setter Property="Foreground" Value="{DynamicResource Brushes.HunterPie.Accent.Primary}" />
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</local:Button.Style>
		<Grid>
			<Grid Margin="10,5">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="30" />
					<ColumnDefinition Width="1*" />
				</Grid.ColumnDefinitions>

				<Rectangle Grid.Column="0"
				           Width="20"
				           Height="{Binding Width, RelativeSource={RelativeSource Self}}"
				           HorizontalAlignment="Stretch"
				           VerticalAlignment="Stretch"
				           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:TabItem}}}">
					<Rectangle.OpacityMask>
						<ImageBrush d:ImageSource="{StaticResource ICON_DISCORD}"
						            ImageSource="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type local:TabItem}}}"
						            Stretch="Uniform"
						            TileMode="Tile" />
					</Rectangle.OpacityMask>
				</Rectangle>

				<TextBlock Grid.Column="1"
				           Margin="10,0,0,0"
				           VerticalAlignment="Center"
				           FontWeight="Medium"
				           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type local:Button}}}"
				           Text="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type local:TabItem}}}" />
			</Grid>
		</Grid>
	</local:Button>
</UserControl>
