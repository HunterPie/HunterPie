<UserControl x:Class="HunterPie.UI.Controls.Paginating.Pagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:HunterPie.UI.Controls.Buttons"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:image="clr-namespace:HunterPie.UI.Controls.Image"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:HunterPie.UI.Controls.Paginating.ViewModels"
             x:Name="PaginationControl"
             d:DesignHeight="40"
             mc:Ignorable="d">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
		<Style x:Key="PaginationButtonStyle"
		       TargetType="buttons:Button">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Width" Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
			<Setter Property="Padding" Value="10" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Background.Primary}" />
			<Setter Property="BorderBrush" Value="{DynamicResource Brushes.HunterPie.Border}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="5" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}"
				             Value="False">
					<Setter Property="Opacity" Value="0.4" />
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<DataTemplate x:Key="NormalPaginationItemTemplate"
		              DataType="{x:Type viewModels:PaginationItemViewModel}">
			<buttons:Button BorderThickness="1"
			                Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
			                Margin="1,0"
			                Click="OnPageButtonClick"
			                Content="{Binding Page, Mode=OneWay}"
			                CornerRadius="5"
			                Cursor="Hand"
			                Foreground="{DynamicResource Brushes.HunterPie.Foreground.Primary}"
			                Visibility="{Binding IsVisible, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
				<buttons:Button.Style>
					<Style TargetType="buttons:Button">
						<Setter Property="BorderBrush" Value="{DynamicResource Brushes.HunterPie.Accent.Secondary}" />
						<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Accent.Tertiary}" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsActive, Mode=OneWay}"
							             Value="False">
								<Setter Property="BorderBrush" Value="{DynamicResource Brushes.HunterPie.Border}" />
								<Setter Property="Background" Value="{DynamicResource Brushes.HunterPie.Background.Primary}" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</buttons:Button.Style>
			</buttons:Button>
		</DataTemplate>

	</UserControl.Resources>
	<StackPanel Orientation="Horizontal">
		<buttons:Button Click="OnPreviousPageClick"
		                IsEnabled="{Binding CanPaginatePrevious, ElementName=PaginationControl}"
		                Style="{StaticResource PaginationButtonStyle}">
			<image:Icon Foreground="{DynamicResource Brushes.HunterPie.Foreground.Tertiary}"
			            Image="{DynamicResource ICON_CHEVRON_LEFT}" />
		</buttons:Button>

		<ItemsControl Margin="2,0"
		              ItemTemplate="{StaticResource NormalPaginationItemTemplate}"
		              ItemsSource="{Binding Pages, Mode=OneTime, ElementName=PaginationControl}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<StackPanel IsItemsHost="True"
					            Orientation="Horizontal" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
		</ItemsControl>

		<buttons:Button Click="OnNextPageClick"
		                IsEnabled="{Binding CanPaginateNext, ElementName=PaginationControl}"
		                Style="{StaticResource PaginationButtonStyle}">
			<image:Icon Foreground="{DynamicResource Brushes.HunterPie.Foreground.Tertiary}"
			            Image="{DynamicResource ICON_CHEVRON_RIGHT}" />
		</buttons:Button>
	</StackPanel>
</UserControl>
