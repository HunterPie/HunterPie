<UserControl x:Class="HunterPie.Playground.Dogma.Components.BossHealthBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:HunterPie.UI.Architecture.Converters;assembly=HunterPie.UI"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:HunterPie.Playground.Dogma.Components"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shaders="clr-namespace:HunterPie.Playground.Dogma.UI.Shaders"
             x:Name="BossHealthBarComponent"
             d:DesignHeight="8"
             d:DesignWidth="800"
             mc:Ignorable="d">
	<UserControl.Resources>
		<converters:CurrentValueToWidthConverter x:Key="CurrentValueToWidthConverter" />
	</UserControl.Resources>
	<Grid>
		<Rectangle Fill="Gray"
		           Opacity="0.5" />

		<Rectangle HorizontalAlignment="Left"
		           d:Width="600"
		           Fill="White">
			<Rectangle.Width>
				<MultiBinding Converter="{StaticResource CurrentValueToWidthConverter}">
					<Binding ElementName="BossHealthBarComponent"
					         Path="CurrentBuffer" />
					<Binding ElementName="BossHealthBarComponent"
					         Path="Max" />
					<Binding ElementName="BossHealthBarComponent"
					         Path="ActualWidth" />
				</MultiBinding>
			</Rectangle.Width>
			<Rectangle.Effect>
				<shaders:PlasmaShaderEffect BaseColor="#ffc7f8"
				                            CoreColor="White"
				                            Time="{Binding RenderTime, Mode=OneWay, ElementName=BossHealthBarComponent}" />
			</Rectangle.Effect>
		</Rectangle>

		<Rectangle HorizontalAlignment="Left"
		           d:Width="500"
		           Fill="White">
			<Rectangle.Width>
				<MultiBinding Converter="{StaticResource CurrentValueToWidthConverter}">
					<Binding ElementName="BossHealthBarComponent"
					         Path="Current" />
					<Binding ElementName="BossHealthBarComponent"
					         Path="Max" />
					<Binding ElementName="BossHealthBarComponent"
					         Path="ActualWidth" />
				</MultiBinding>
			</Rectangle.Width>
			<Rectangle.Effect>
				<shaders:PlasmaShaderEffect BaseColor="#fc0384"
				                            CoreColor="#ffc7f8"
				                            Time="{Binding RenderTime, Mode=OneWay, ElementName=BossHealthBarComponent}" />
			</Rectangle.Effect>
		</Rectangle>
	</Grid>
</UserControl>
