<overlay:Widget x:Class="HunterPie.Playground.Dogma.Views.DragonsDogmaMonstersView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:display="clr-namespace:HunterPie.UI.Controls.Display;assembly=HunterPie.UI"
                xmlns:local="clr-namespace:HunterPie.Playground.Dogma.Views"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:overlay="clr-namespace:HunterPie.UI.Overlay;assembly=HunterPie.UI"
                xmlns:viewmodels="clr-namespace:HunterPie.Playground.Dogma.ViewModels"
                xmlns:visibilities="clr-namespace:HunterPie.UI.Architecture.Converters.Visibilities;assembly=HunterPie.UI"
                Width="800"
                d:DataContext="{d:DesignInstance viewmodels:DragonsDogmaMonstersViewModel}"
                mc:Ignorable="d">

	<UserControl.Resources>
		<visibilities:NullableToVisibilityConverter x:Key="NullableToVisibilityConverter" />
	</UserControl.Resources>

	<local:DragonsDogmaMonsterView d:Visibility="Visible"
	                               DataContext="{Binding Target, Mode=OneWay}"
	                               Visibility="{Binding ., Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />
</overlay:Widget>
